<Window x:Class="ShoeStore_AO.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заказов" Height="600" Width="800"
        FontFamily="Times New Roman" Background="White" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="10" CornerRadius="10">
            <TextBlock Text="Заказы" FontSize="22" HorizontalAlignment="Center" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Name="BtnAddOrder" Content="Добавить заказ" Padding="10,5" Background="#00FA9A" Margin="0,0,10,0" Click="BtnAddOrder_Click"/>
            <Button Name="BtnDeleteOrder" Content="Удалить заказ" Padding="10,5" Background="#FFB6C1" Click="BtnDeleteOrder_Click"/>
        </StackPanel>

        <!-- Обязательно Name="ListOrders" -->
        <ListView Name="ListOrders" Grid.Row="2" Margin="10" MouseDoubleClick="ListOrders_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" Text="{Binding OrderID, StringFormat=Артикул заказа: {0}}"/>
                                <TextBlock Text="{Binding OrderStatuses.StatusName, StringFormat=Статус: {0}}"/>
                                <TextBlock Text="{Binding PickupPoints.Address, StringFormat=Адрес ПВЗ: {0}}"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat=Дата заказа: {0:dd.MM.yyyy}}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5" Padding="5">
                                <TextBlock Text="{Binding DeliveryDate, StringFormat=Дата выдачи: {0:dd.MM.yyyy}}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>